rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'shariartech2010@gmail.com' || 
        request.auth.token.email == 'thedavid6758@gmail.com'
      );
    }

    // Products
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Banners
    match /banners/{bannerId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Notices
    match /notices/{noticeId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow get, list: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Payment Requests
    match /paymentRequests/{requestId} {
      allow create: if request.auth != null;
      allow get, list: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow get, list: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Global catch
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
